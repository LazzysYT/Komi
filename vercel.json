{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/hero/daily/:image([0-9]+-[A-Za-z0-9_-]+\\.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://cdn.jsdelivr.net https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js; script-src-elem 'self' https://cdn.jsdelivr.net https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; worker-src 'self' blob:"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; media-src 'self' https: blob:; frame-src https:; worker-src 'self' blob:; connect-src 'self' https://xebglnnpoutmdcgukbxf.supabase.co wss://xebglnnpoutmdcgukbxf.supabase.co https://graphql.anilist.co https://api.allorigins.win https://cdn.jsdelivr.net"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "^komianime\\.online$"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/shop",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/partners",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/profile",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/episode-stills/:kind(map|data)/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/episode-stills/map/:shard([0-9]+)/:id([0-9]+).json",
      "destination": "https://cdn.jsdelivr.net/gh/anilifecommunity/media-index@main/data/mappings/mal/:shard/:id.json"
    },
    {
      "source": "/episode-stills/data/:shard([0-9]+)/:id([0-9]+).json",
      "destination": "https://cdn.jsdelivr.net/gh/anilifecommunity/media-index@main/data/anime/:shard/:id/episodes.json"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/partners",
      "destination": "/index.html"
    },
    {
      "source": "/shop",
      "destination": "/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/anime/:id",
      "destination": "/api/anime?id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contacts",
      "destination": "/contacts.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(komi-six|komi-ukiyo6|komi-git-main-ukiyo6)\\.vercel\\.app$"
        }
      ],
      "destination": "https://komianime.online/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.komianime.online"
        }
      ],
      "destination": "https://komianime.online/:path*",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contacts.html",
      "destination": "/contacts",
      "permanent": true
    }
  ],
  "buildCommand": "npx --yes --package=esbuild@0.25.12 --package=postcss@8.5.6 -- node scripts/minify-static.cjs",
  "outputDirectory": ".",
  "functions": {
    "api/catalog.js": {
      "includeFiles": "index.html"
    }
  }
}
